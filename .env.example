# ── Local Development Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/fluxtv?schema=public"

NODE_ENV=development
DATABASE_SSL=false

NEXT_PUBLIC_PAGE_LIMIT=24
# Production: https://tv.pasiths.tech
NEXT_PUBLIC_APP_URL=http://localhost:3002
COOKIE_SECURE=false

# Optional custom Cast receiver (default: Google Default Media Receiver)
# NEXT_PUBLIC_CAST_APP_ID=CC1AD845

# Auto English captions (Whisper translations). Prefer one:
# OPENAI_API_KEY=sk-...
# OPENAI_WHISPER_MODEL=whisper-1
# GROQ_API_KEY=gsk_...
# GROQ_WHISPER_MODEL=whisper-large-v3
