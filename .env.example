# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fluxtv?schema=public"
# DATABASE_SSL=false
#
# Managed (Aiven / Neon / etc.) — TLS required:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/fluxtv?sslmode=require"
# On Vercel, prefer Aiven "Pool" / PgBouncer URL (fewer direct connections):
# DATABASE_POOL_URL="postgresql://USER:PASSWORD@HOST-pooler:PORT/fluxtv?sslmode=require"
DATABASE_SSL=true
# Serverless defaults to pool max=1; override only if you know your plan limits:
# DATABASE_POOL_MAX=1
# Optional full TLS verify (requires a matching provider CA):
# DATABASE_SSL_VERIFY=true
# DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

NODE_ENV=development

NEXT_PUBLIC_PAGE_LIMIT=24
# Production: https://tv.pasiths.tech
NEXT_PUBLIC_APP_URL=http://localhost:3002
COOKIE_SECURE=false

# Optional custom Cast receiver (default: Google Default Media Receiver)
# NEXT_PUBLIC_CAST_APP_ID=CC1AD845

# Auto English captions (Whisper translations). Prefer one:
# OPENAI_API_KEY=sk-...
# OPENAI_WHISPER_MODEL=whisper-1
# GROQ_API_KEY=gsk_...
# GROQ_WHISPER_MODEL=whisper-large-v3
